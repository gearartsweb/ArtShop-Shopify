{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: clamp(20px, 4vw, 56px);
  }

  .ai-editorial-{{ ai_gen_id }}__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.8fr);
    gap: clamp(28px, 6vw, 88px);
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-editorial-{{ ai_gen_id }}__visual {
    position: relative;
    min-width: 0;
  }

  .ai-editorial-{{ ai_gen_id }}__image,
  .ai-editorial-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: #f1eee8;
  }

  .ai-editorial-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-{{ ai_gen_id }}__image-caption {
    margin: 10px 0 0;
    color: {{ block.settings.text_color }};
    font-size: 12px;
    line-height: 1.5;
    opacity: 0.75;
  }

  .ai-editorial-{{ ai_gen_id }}__copy {
    padding: 8px 0;
  }

  .ai-editorial-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 20px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__heading {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(36px, 5vw, {{ block.settings.heading_size }}px);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.02;
    overflow-wrap: anywhere;
  }

  .ai-editorial-{{ ai_gen_id }}__rule {
    width: 52px;
    height: 2px;
    margin: 26px 0;
    border: 0;
    background: {{ block.settings.accent_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__dek {
    color: {{ block.settings.text_color }};
    font-size: 17px;
    line-height: 1.7;
  }

  .ai-editorial-{{ ai_gen_id }}__dek p {
    margin: 0 0 14px;
  }

  .ai-editorial-{{ ai_gen_id }}__byline {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 24px;
    color: {{ block.settings.text_color }};
    font-size: 12px;
    letter-spacing: 0.06em;
    opacity: 0.8;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding: 0 0 7px;
    border: 0;
    border-bottom: 1px solid currentColor;
    color: {{ block.settings.text_color }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid {{ block.settings.accent_color }};
    outline-offset: 4px;
  }

  .ai-editorial-{{ ai_gen_id }}__link svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }

  .ai-editorial-{{ ai_gen_id }}__empty {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    padding: 10px 12px;
    background: rgba(255, 255, 255, 0.94);
    color: #333333;
    font-size: 13px;
    line-height: 1.4;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-{{ ai_gen_id }} {
      width: 100%;
      padding: 22px 18px;
    }

    .ai-editorial-{{ ai_gen_id }}__layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .ai-editorial-{{ ai_gen_id }}__visual {
      order: 0;
    }

    .ai-editorial-{{ ai_gen_id }}__copy {
      order: 1;
    }
  }
{% endstyle %}

<div class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-{{ ai_gen_id }}__layout">
    <div class="ai-editorial-{{ ai_gen_id }}__visual">
      {% if block.settings.image != blank %}
        <img
          class="ai-editorial-{{ ai_gen_id }}__image"
          src="{{ block.settings.image | image_url: width: 1600 }}"
          alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="ai-editorial-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-editorial-{{ ai_gen_id }}__empty">Choose an image to complete this editorial feature.</div>
        </div>
      {% endif %}
      {% if block.settings.caption != blank %}
        <p class="ai-editorial-{{ ai_gen_id }}__image-caption">{{ block.settings.caption | escape }}</p>
      {% endif %}
    </div>

    <div class="ai-editorial-{{ ai_gen_id }}__copy">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="ai-editorial-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      {% endif %}
      <hr class="ai-editorial-{{ ai_gen_id }}__rule">
      {% if block.settings.body != blank %}
        <div class="ai-editorial-{{ ai_gen_id }}__dek">{{ block.settings.body }}</div>
      {% endif %}
      {% if block.settings.author != blank or block.settings.date_text != blank %}
        <div class="ai-editorial-{{ ai_gen_id }}__byline">
          {% if block.settings.author != blank %}<span>{{ block.settings.author | escape }}</span>{% endif %}
          {% if block.settings.date_text != blank %}<span>{{ block.settings.date_text | escape }}</span>{% endif %}
        </div>
      {% endif %}
      {% if block.settings.link_label != blank and block.settings.link_url != blank %}
        <a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ block.settings.link_url }}">
          {{ block.settings.link_label | escape }}
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 10h13M10 4l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial feature",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "image_picker", "id": "image", "label": "Feature image" },
    { "type": "text", "id": "caption", "label": "Image caption" },
    { "type": "text", "id": "eyebrow", "label": "Category", "default": "Studio notes" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "The art of seeing colour" },
    { "type": "richtext", "id": "body", "label": "Story", "default": "<p>Explore the ideas, materials and techniques that shape an artist’s practice. A considered perspective for curious makers.</p>" },
    { "type": "text", "id": "author", "label": "Byline", "default": "The Art Shop journal" },
    { "type": "text", "id": "date_text", "label": "Date or issue", "default": "Issue 01" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the story" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "range", "id": "heading_size", "label": "Headline size", "min": 36, "max": 72, "step": 4, "unit": "px", "default": 56 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#333333" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#8A2D20" }
  ],
  "presets": [{ "name": "Editorial feature" }],
  "tag": null,
  "class": "editorial-feature-block"
}
{% endschema %}