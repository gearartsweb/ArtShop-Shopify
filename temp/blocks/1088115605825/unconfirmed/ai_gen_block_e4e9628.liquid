{% doc %}
  @prompt
    A heading with an animated glowing effect
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glow-heading-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    line-height: 1.15;
    text-align: {{ block.settings.alignment }};
    text-wrap: balance;
  }

  .ai-glow-heading-{{ ai_gen_id }}__text {
    display: inline;
    text-shadow: 0 0 {{ block.settings.glow_blur }}px {{ block.settings.glow_color }};
    animation: ai-glow-pulse-{{ ai_gen_id }} {{ block.settings.animation_duration }}s ease-in-out infinite alternate;
  }

  @keyframes ai-glow-pulse-{{ ai_gen_id }} {
    from {
      text-shadow: 0 0 {{ block.settings.glow_blur | divided_by: 2 }}px {{ block.settings.glow_color }};
    }
    to {
      text-shadow: 0 0 {{ block.settings.glow_blur }}px {{ block.settings.glow_color }}, 0 0 {{ block.settings.glow_blur | times: 2 }}px {{ block.settings.glow_color }};
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-glow-heading-{{ ai_gen_id }}__text {
      animation: none;
      text-shadow: 0 0 {{ block.settings.glow_blur }}px {{ block.settings.glow_color }};
    }
  }
{% endstyle %}

<h2 class="ai-glow-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <span class="ai-glow-heading-{{ ai_gen_id }}__text">{{ block.settings.heading | escape }}</span>
</h2>

{% schema %}
{
  "name": "Glowing heading",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create something brilliant"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "work_sans_n4"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow color",
      "default": "#E85D04"
    },
    {
      "type": "range",
      "id": "glow_blur",
      "label": "Glow intensity",
      "min": 2,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Pulse speed",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Glowing heading"
    }
  ],
  "tag": null,
  "class": "glowing-heading-block"
}
{% endschema %}