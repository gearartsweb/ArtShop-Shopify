<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>

  <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">

  {%- comment -%} ── DESIGN TOKENS (must load before critical.css) ── {%- endcomment -%}
  {%- render 'css-variables' -%}

  {%- comment -%} ── CHARSET & VIEWPORT ── {%- endcomment -%}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {%- comment -%} ── FONT PRECONNECT & PRELOAD ── {%- endcomment -%}
  {%- unless settings.type_primary_font.system? -%}
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
  {%- endunless -%}

  {%- comment -%} ── GOOGLE FONTS (Playfair Display + Inter) ── {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap"></noscript>

  {%- comment -%} ── CRITICAL CSS ── {%- endcomment -%}
  {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

  {%- comment -%} ── SEO & SOCIAL META ── {%- endcomment -%}
  {%- render 'meta-tags' -%}

  {{ content_for_header }}

</head>
<body>

  {%- comment -%} ── HEADER ── {%- endcomment -%}
  {%- section 'header' -%}

  {%- comment -%} ── MAIN CONTENT ── {%- endcomment -%}
  <main
    id="MainContent"
    class="content-for-layout"
    role="main"
    tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- comment -%} ── FOOTER ── {%- endcomment -%}
  <footer class="site-frame-footer" role="contentinfo">
    {%- section 'footer' -%}
  </footer>

  {%- comment -%} ── CART DRAWER ── {%- endcomment -%}
  {%- section 'cart-drawer' -%}

  {%- comment -%} ── SCROLL REVEAL ── {%- endcomment -%}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (!('IntersectionObserver' in window)) return;
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08 });
      document.querySelectorAll('.reveal-on-scroll').forEach(function(el) {
        observer.observe(el);
      });
    });
  </script>

  {%- comment -%} ── BODY OVERFLOW RESET ── {%- endcomment -%}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      document.body.style.overflow = '';
    });
  </script>

</body>
</html>
